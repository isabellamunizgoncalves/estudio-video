# Copie para .env e preencha. O .env nunca vai para o git.

# Google AI Studio (narração Gemini TTS) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comentários do YouTube (opcional: sem ela, usamos yt-dlp) — Google Cloud Console > YouTube Data API v3
YOUTUBE_API_KEY=

# Bancos de imagens e vídeos (todos gratuitos)
PEXELS_API_KEY=        # https://www.pexels.com/api/
PIXABAY_API_KEY=       # https://pixabay.com/api/docs/
# Wikimedia Commons, Openverse e Internet Archive não precisam de chave.

# Whisper (verificação da narração): tiny, base, small, medium, large-v3
WHISPER_MODELO=small
